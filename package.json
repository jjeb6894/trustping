{
  "name": "trustping",
  "version": "0.1.0",
  "private": true,
  "description": "TrustPing — paste a listing link, get a Trust Score. Cloudflare Pages + D1 scaffold.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "db:migrate:local": "wrangler d1 migrations apply trustping-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trustping-db --remote"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "16.2.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.2",
    "@cloudflare/workers-types": "4.20240725.0",
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "wrangler": "3.67.1"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
